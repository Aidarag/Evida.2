{
  "version": 2,
  "build": {
    "env": {
      "VERCEL_BUILD_CONCURRENCY": "2",
      "NODE_VERSION": "18.x"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false
}
